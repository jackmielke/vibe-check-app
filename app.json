{
  "expo": {
    "name": "Vibe",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Vibe needs the camera to check your selfie energy.",
          "photosPermission": "Vibe needs your photos so you can check an existing shot."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jackmielke.myapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Vibe needs the camera to check your selfie energy.",
        "NSPhotoLibraryUsageDescription": "Vibe needs your photos so you can check an existing shot."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3e80a1cb-5a36-4ff2-af8e-9e0e56f5283d"
      }
    },
    "owner": "jackmielke",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3e80a1cb-5a36-4ff2-af8e-9e0e56f5283d"
    }
  }
}
